# IoT Security Scanner - Environment Configuration
# Copy this file to .env and update with your values

# Flask Configuration
SECRET_KEY=change-this-to-a-random-secret-key-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# Database Configuration - PostgreSQL
# Format: postgresql://username:password@host:port/database_name
# Example: postgresql://iot_user:secure_password@localhost:5432/iot_scanner_db
DATABASE_URL=postgresql://your_username:your_password@localhost:5432/iot_scanner_db

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Security Configuration
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# API Configuration
API_PREFIX=/api

# Scanning Configuration
SCAN_TIMEOUT=300
MAX_CONCURRENT_SCANS=5

# Report Configuration
REPORTS_FOLDER=reports
REPORT_FORMATS=html,pdf,json
